{
  "name": "dsh-netease-music",
  "version": "1.0.0",
  "description": "DSH 网页版网易云音乐播放器插件：顶部条常驻迷你播放器 + 展开面板（每日推荐/歌单/私人FM/搜索/队列/历史/设置），扫码登录，内置自动启动 NeteaseCloudMusicApi，支持 AI 对话控制播放。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "netease",
    "netease-cloud-music",
    "music"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonCHTT/dsh-netease-music.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "dependencies": {},
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
